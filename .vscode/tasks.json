{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build APK",
      "type": "shell",
      "command": ".\\gradlew.bat assembleDebug",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Sync Version & Build APK",
      "type": "shell",
      "command": ".\\sync_version_and_build.bat",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Git Pull (Von GitHub holen)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-Command",
        "git fetch origin; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; git pull --ff-only origin main; exit $LASTEXITCODE"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
